  "description": "Physical memory pressure for pi — TUI stats, per-project attribution, and a graded intervention ladder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbrdc/pi-ballast.git"
  },
  "homepage": "https://github.com/zbrdc/pi-ballast#readme",
  "bugs": {
    "url": "https://github.com/zbrdc/pi-ballast/issues"
  },
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
